(version 1)

# Accepterede courtyard-overlap (beslutning 2026-11-04): printet er produceret og virker med denne
# placering. Pad-til-pad 0,30-0,5 mm, kobber overholder 0,15 mm clearance. Se README.md.
# Kun disse par ignoreres - nye overlap fanges stadig af DRC.

(rule "Accepteret tæt placering C4-U6"
  (constraint courtyard_clearance (min 0mm))
  (severity ignore)
  (condition "(A.Reference == 'C4' && B.Reference == 'U6') || (A.Reference == 'U6' && B.Reference == 'C4')"))

(rule "Accepteret tæt placering C5-U6"
  (constraint courtyard_clearance (min 0mm))

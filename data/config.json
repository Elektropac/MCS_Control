{
    // ============================================================
    // ACTIVE CONFIG — CloudGauge 2
    // ============================================================
    "product": "cloudgauge2",
    "version": 1,
    "name": "CloudGauge Dev",
    "channels": {
        "A": { "voltage": 24 },
        "B": { "voltage": 24 }
    },
    "connection": {
        "server": {
            "local": {
                "host": "192.168.10.129",
                "port": 3000,
                "path": "/ws"
            },
            "global": {
                "host": "echo.websocket.org",
                "port": 443,
                "path": "/ws"
            }
        },
        "internet_client": "ethernet",
        "settings": {
            "ethernet": {
                "dhcp": false
            }
        }
    },
    "probes": [
        { "id": "tank_1", "type": "mcs_level", "input": "A1",
          // "lut": cm vs liter — målt med pejlestang, max 10 punkter
          "lut": [[0, 0], [30, 1500], [60, 3200], [90, 5000], [120, 7000], [150, 9200], [180, 11500], [210, 14000], [240, 16500], [270, 19000]]
        },
        { "id": "tank_2", "type": "mcs_level", "input": "A2" },
        { "id": "tank_3", "type": "mcs_level", "input": "A3" },
        { "id": "tank_4", "type": "mcs_level", "input": "A4" },
        { "id": "tank_5", "type": "mcs_level", "input": "B1" },
        { "id": "tank_6", "type": "mcs_level", "input": "B2" },
        { "id": "tank_7", "type": "mcs_level", "input": "B3" },
        { "id": "tank_8", "type": "mcs_level", "input": "B4" }
    ]


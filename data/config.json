{
  // Test config: 1 probe + 1 pump group, DHCP.
  "connection": { "settings": { "ethernet": { "dhcp": true } } },

  "config": {
    "guide": "cloudgauge2",
    "connection": {
      "internet_client": "ethernet",
      "settings": { "ethernet": { "mode": "dhcp" } }
    },
    "channels": {
      "A": { "voltage": 24 },
      "B": { "voltage": 24 }
    }
  },

  "groups": [
    {
      "id": "probe_1",
      "type": "probe",
      "probe": {
        "name": "Probe 1",
        "input": "A1",
        "probe_type": "mcs_level",
        "media": "Diesel",
        "density": 0.84,
        "alarm_unit": "%",
        "low_level": 10,
        "overfill": 95,
        "lut": [ [0,0],[1000,2000],[2000,4000],[3000,5000] ]
      },
      "rules": []
    },
    {
      "id": "fueling_1",
      "type": "pump",
      "channel": "B",
      "pump": {
        "name": "Pump 1",
        "channel": "B",
        "nozzle": "B1",
        "pulse": "B2",
        "relay": "relay_b",
        "pulses_per_litre": 10,
        "preset_litres": 0
      },
      "rules": []
    }
  ]
}

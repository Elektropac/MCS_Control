{
    // ============================================================
    // TRANSITION CONFIG — CloudGauge 2
    // Holds BOTH the old shape (product + probes[], so the cloudgauge
    // measurement keeps running) AND a "config" block with "guide"
    // (read on-demand by product_display to show the OLED splash).
    // ============================================================

    // New-format block — read on-demand (config_read_string).
    "config": {
        "guide": "cloudgauge2"
    },

    // --- Old-format fields below keep the current firmware working ---
    "product": "cloudgauge2",
    "version": 1,
    "name": "CloudGauge Dev",
    "channels": {
        "A": { "voltage": 24 },
        "B": { "voltage": 24 }
    },
    "connection": {
        "server": {
            "local":  { "host": "192.168.10.129", "port": 3000, "path": "/ws" },
            "global": { "host": "echo.websocket.org", "port": 443, "path": "/ws" }
        },
        "internet_client": "ethernet",
        "settings": {
            "ethernet": { "dhcp": false, "ip": "192.168.1.200", "gateway": "192.168.1.1", "subnet": "255.255.255.0" }
        }
    },
    "probes": [
        { "id": "tank_1", "type": "mcs_level", "input": "A1",
          "lut": [[0, 0], [300, 1500], [600, 3200], [900, 5000], [1200, 7000], [1500, 9200], [1800, 11500], [2100, 14000], [2400, 16500], [2700, 19000]]
        },
        { "id": "tank_2", "type": "mcs_level", "input": "A2" },
        { "id": "tank_3", "type": "mcs_level", "input": "A3" },
        { "id": "tank_4", "type": "mcs_level", "input": "A4" },
        { "id": "tank_5", "type": "mcs_level", "input": "B1" },
        { "id": "tank_6", "type": "mcs_level", "input": "B2" },
        { "id": "tank_7", "type": "mcs_level", "input": "B3" },
        { "id": "tank_8", "type": "mcs_level", "input": "B4" }
    ]
}
